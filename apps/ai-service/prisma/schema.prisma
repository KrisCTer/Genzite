// ============================================================
// Genzite AI Service — Prisma Schema
// PostgreSQL schema isolation: "ai"
// Resume/Interview data uses JSONB per architecture rules
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-ai"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["ai"]
}

// ===================== AI TASK LOG =====================
// Tracks all AI generation jobs for auditing and retry logic.

enum AiTaskType {
  SITE_GENERATION
  CMS_GENERATION
  AGENT_TASK

  @@schema("ai")
}


enum AiTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("ai")
}

model AiTaskLog {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  taskType  AiTaskType   @map("task_type")
  status    AiTaskStatus @default(PENDING)
  input     Json         @default("{}")
  output    Json?
  error     String?
  startedAt DateTime?    @map("started_at")
  endedAt   DateTime?    @map("ended_at")
  createdAt DateTime     @default(now()) @map("created_at")

  // Metrics
  tokenUsage Int?         @map("token_usage")
  cost       Float?       @map("cost")

  // Training / RLHF Information
  modelUsed     String?      @map("model_used")
  userRating    Int?         @map("user_rating")
  userFeedback  String?      @map("user_feedback")
  isExported    Boolean      @default(false) @map("is_exported")

  @@index([userId])
  @@index([taskType, status])
  @@map("ai_task_logs")
  @@schema("ai")
}

// ===================== AI TEMPLATES =====================
// Admin-managed Golden Templates for RAG

model AiTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String
  tags        String[]
  content     Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("ai_templates")
  @@schema("ai")
}
