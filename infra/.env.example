# ============================================================
# Genzite — Shared Environment Variables
# One file to rule them all. Used by ALL services.
# ============================================================

# PostgreSQL / Supabase
#SUPABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"
#SUPABASE_DIRECT_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Local PostgreSQL Fallback (used if SUPABASE_URL is not set)
POSTGRES_USER=genzite_user
POSTGRES_PASSWORD=genzite_password
POSTGRES_DB=genzite_dev
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:29092

# Auth
AUTH_BYPASS=false
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here

# Local DB for CLI (prisma migrate/seed from host). Docker identity uses SUPABASE_URL when set.
DB_TARGET=local

# AI
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_DEFAULT_PROVIDER=gemini
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# MCP External Servers
MCP_SERVERS='[{"name":"codebase","transport":"stdio","command":"node","args":["./node_modules/.bin/codebase-memory-mcp"]}]'

# AWS S3 (Media Service)
AWS_S3_BUCKET=your-aws-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Cognito Configuration
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/your_user_pool_id
VITE_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_COGNITO_REDIRECT_URI=http://localhost:5174/
VITE_COGNITO_DOMAIN=https://your-cognito-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REGION=us-east-1

AWS_COGNITO_USER_POOL_ID=your_user_pool_id
AWS_COGNITO_CLIENT_ID=your_cognito_client_id
AWS_COGNITO_REGION=us-east-1

# Stitch SDK
STITCH_API_KEY=your_stitch_api_key_here

# SITE GENERATION MODE (stitch | hybrid)
GENERATION_MODE=hybrid

# Seed Admin Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Admin@12345

#login email (Dùng App Password của Google)
EMAIL_USERNAME=system@yourdomain.com
EMAIL_PASSWORD=your_google_app_password_here
