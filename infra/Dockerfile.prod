# ==========================================
# Stage 1: Build Stage
# ==========================================
FROM node:20-alpine AS builder

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy root workspace configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./

# Copy all packages and apps source code
COPY packages ./packages
COPY apps ./apps

# Install ALL dependencies (devDependencies are needed for build)
RUN pnpm install --frozen-lockfile

# Accept the service name and Vite API URL as build arguments
ARG APP_NAME
ARG VITE_API_URL
ENV APP_NAME=${APP_NAME}
ENV VITE_API_URL=${VITE_API_URL}

# If the app has a Prisma schema, generate the client first
RUN if [ -d "apps/${APP_NAME}/prisma" ]; then \
      pnpm --filter ${APP_NAME} exec prisma generate; \
    fi

# Build the specific app (and any local workspace dependencies like @genzite/shared-types)
RUN pnpm --filter ${APP_NAME}... build

# Deploy the app to an isolated directory containing ONLY production dependencies and built files
RUN pnpm --filter ${APP_NAME} deploy --prod /app/out

# pnpm deploy ignores dist/ because of .gitignore, so we manually copy it
RUN cp -r apps/${APP_NAME}/dist /app/out/dist || true

# pnpm deploy ignores node_modules/@prisma because it's locally generated
RUN if [ -d "apps/${APP_NAME}/node_modules/@prisma" ]; then \
      mkdir -p /app/out/node_modules/@prisma && \
      cp -r apps/${APP_NAME}/node_modules/@prisma/* /app/out/node_modules/@prisma/ || true; \
    fi
RUN if [ -d "apps/${APP_NAME}/node_modules/.prisma" ]; then \
      mkdir -p /app/out/node_modules/.prisma && \
      cp -r apps/${APP_NAME}/node_modules/.prisma/* /app/out/node_modules/.prisma/ || true; \
    fi


# ==========================================
# Stage 2: Production Runner
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Install simple http server for serving static frontend and prisma CLI for migrations
RUN npm install -g serve prisma@6

# Copy the isolated app directly (it already contains dist, package.json, and prod node_modules with Prisma client)
COPY --from=builder /app/out ./

EXPOSE ${PORT}

# Start the application dynamically based on whether it's a backend (NestJS) or frontend (Vite static files)
CMD ["sh", "-c", "if [ -d prisma ]; then prisma migrate deploy; fi; if [ -f dist/src/main.js ]; then node dist/src/main.js; elif [ -f dist/main.js ]; then node dist/main.js; else serve -s dist -l tcp://0.0.0.0:${PORT}; fi"]
